{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "agent": {
    "nddev-builder": {
      "description": "Review and maintain NDDev native MiMo Code setup artifacts.",
      "mode": "subagent",
      "permission": {
        "*": "ask",
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "skill": {
          "*": "allow",
          "nddev-builder": "allow"
        }
      },
      "prompt": "{file:./instructions/nddev-builder.md}"
    }
  },
  "autoupdate": false,
  "compaction": {
    "disabled": true
  },
  "instructions": [
    "./AGENTS.md",
    "./instructions/nddev-builder.md"
  ],
  "mcp": {},
  "plugin": [],
  "share": "disabled",
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "snapshot": {
    "enabled": false
  },
  "watcher": {
    "enabled": false
  }
}
