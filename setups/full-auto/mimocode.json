{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "agent": {
    "build": {
      "description": "Default autonomous implementation agent with NDDev destructive-operation guardrails.",
      "mode": "primary",
      "permission": {
        "*": "allow",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "rm -rf *": "deny",
          "sudo *": "deny"
        },
        "skill": {
          "*": "allow",
          "nddev-builder": "allow"
        }
      }
    },
    "nddev-builder": {
      "description": "Review and maintain NDDev native MiMo Code setup artifacts.",
      "mode": "subagent",
      "permission": {
        "*": "allow",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "rm -rf *": "deny",
          "sudo *": "deny"
        },
        "skill": {
          "*": "allow",
          "nddev-builder": "allow"
        }
      },
      "prompt": "{file:./instructions/nddev-builder.md}"
    }
  },
  "autoupdate": false,
  "compaction": {
    "disabled": true
  },
  "default_agent": "build",
  "disabled_providers": [],
  "instructions": ["./AGENTS.md", "./instructions/nddev-builder.md"],
  "mcp": {},
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "skill": {
      "*": "allow",
      "nddev-builder": "allow"
    }
  },
  "plugin": [],
  "share": "disabled",
  "skills": {
    "paths": ["./skills"]
  },
  "snapshot": {
    "enabled": false
  },
  "watcher": {
    "enabled": false
  }
}
