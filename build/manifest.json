{
  "schema_version": 2,
  "name": "nddev-mimocode-app",
  "build_version": "0.2.0",
  "entrypoint": "python3 cli-tools/nddev_mimocode.py",
  "source_root": "setups",
  "setup_ids": [
    "nddev-builder"
  ],
  "profile_ids": [
    "full-auto",
    "safe"
  ],
  "default_setup_id": "nddev-builder",
  "default_profile_id": "full-auto",
  "setup_lifecycle": [
    "list",
    "status",
    "plan",
    "install",
    "update",
    "switch",
    "migrate",
    "restore",
    "remove"
  ],
  "managed_files_source": "cli-tools/nddev_mimocode.py:MANAGED_PATHS",
  "permission_policy": {
    "configuration_surface": "native mimocode.json permission plus manager-owned profile launch environment",
    "setup_profile_model": "one content setup with orthogonal runtime profiles",
    "default_profile": "full-auto",
    "safe_profile": "safe",
    "source": "setups/nddev-builder/mimocode.json and profiles/<id>/profile.json"
  },
  "builder_capability": {
    "projection": "mimocode-native-config-skills-agents-instructions",
    "source_root": "plugins/nddev-builder",
    "native_paths_source": "cli-tools/nddev_mimocode.py:BUILDER_SOURCE_FILES",
    "default_on": true,
    "marketplace": null
  },
  "runtime_compatibility": {
    "baseline_ref": "references/mimocode-baseline.json",
    "version_ref": "build/version.json",
    "tested_version": "0.1.9",
    "official_repository": "XiaomiMiMo/MiMo-Code",
    "official_installer": "https://mimo.xiaomi.com/install",
    "official_installer_size": 15819,
    "command": "mimo",
    "supported_product_host_ids": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "rejected_product_host_ids": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "product_host_asset_selection": {
      "macos-arm64": {
        "default": "darwin-arm64"
      },
      "macos-x64": {
        "avx2": "darwin-x64",
        "baseline": "darwin-x64-baseline"
      },
      "ubuntu-glibc-arm64": {
        "default": "linux-arm64"
      },
      "ubuntu-glibc-x64": {
        "avx2": "linux-x64",
        "baseline": "linux-x64-baseline"
      }
    },
    "platform_selection_source": "cli-tools/nddev_mimocode.py:detect_platform_selection",
    "target_preflight_order_source": "cli-tools/nddev_mimocode.py:run"
  }
}
