      "MIMOCODE_DISABLE_CLAUDE_CODE_COMMANDS": "Disables command discovery from ~/.claude/commands and project .claude/commands.",
      "MIMOCODE_DISABLE_CLAUDE_CODE_MCP": "Disables Claude Code MCP compatibility loading from .claude.json files.",
      "MIMOCODE_DISABLE_CLAUDE_IMPORT": "Disables best-effort Claude Code session import during process startup.",
      "MIMOCODE_DISABLE_EXTERNAL_SKILLS": "Disables external .claude, .agents, .codex, and .opencode skill directory scans. Managed native skills under MIMOCODE_CONFIG_DIR and configured skills.paths still load in v0.1.10.",
      "MIMOCODE_PURE": "Skips config-declared external server/TUI plugin origins. v0.1.10 still has separate internal TUI plugins and cwd .mimocode/tui scanning, so the manager also rejects known unmanaged project extension paths before launch.",
      "MIMOCODE_ENABLE_ANALYSIS": "Defaults to enabled in v0.1.10; manager sets 0 for launch, installer, and staged version probes to avoid unrequested telemetry independently of share: disabled.",
      "MIMOCODE_DISABLE_AUTOUPDATE": "Disables automatic update checks for launch and staged probes.",
      "MIMOCODE_DISABLE_LSP_DOWNLOAD": "Disables runtime LSP downloads during launch and staged probes.",
      "MIMOCODE_DISABLE_MODELS_FETCH": "Disables remote model-list fetches during launch and staged probes.",
      "MIMOCODE_DISABLE_PROVIDER_ENV": "Disables upstream provider credential autodiscovery from the child process environment without forcing MIMOCODE_MIMO_ONLY."
    },
